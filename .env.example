# Copy this file to .env and adjust if needed. docker-compose reads .env
# automatically; each service's application.properties reads the same
# variable names (with sensible localhost defaults) when run outside Docker.

# One shared credential pair across all four independent Postgres containers
# (order/inventory/payment/odm each get their own container and database name -
# see docker-compose.yml - only the login credentials are reused for simplicity).
DB_USERNAME=pocuser
DB_PASSWORD=pocpass

ORDER_POSTGRES_DB=orderdb
INVENTORY_POSTGRES_DB=inventorydb
PAYMENT_POSTGRES_DB=paymentdb
ODM_POSTGRES_DB=odmdb
