# Copy this file to .env and adjust if needed. docker-compose reads .env
# automatically; each service's application.properties reads the same
# variable names (with sensible localhost defaults) when run outside Docker.

# One shared credential pair across all four independent Postgres containers
# (order/inventory/payment/odm each get their own container and database name -
# see docker-compose.yml - only the login credentials are reused for simplicity).
DB_USERNAME=pocuser
DB_PASSWORD=pocpass

ORDER_POSTGRES_DB=orderdb
INVENTORY_POSTGRES_DB=inventorydb
PAYMENT_POSTGRES_DB=paymentdb
ODM_POSTGRES_DB=odmdb

# The credentials above are throwaway values for the local containers only. Never reuse them
# for, or put real credentials of, a shared environment in this file.

# --- Optional demo settings (defaults shown; uncomment to change) ---------------------
# Durable Temporal timer after ODM decisions in the order lifecycle (makes transitions visible).
# TEMPORAL_DEMO_DELAY_ENABLED=true
# TEMPORAL_DEMO_DELAY_SECONDS=10
# Full-Serve consumer alert schedule and markets with alerts enabled.
# ODM_FULLSERVE_ALERT_SCHEDULE=0s,2m,10m
# ODM_FULLSERVE_ALERT_MARKETS=US,GB,DE
# Admin password of the LOCAL Solace broker's web console (http://localhost:8087).
# SOLACE_ADMIN_PASSWORD=admin
